# Copying is unnecessary when install.sh creates functional_example/site.env.
# Values are consumed only from the process environment and are never copied
# into optimizer histories.
export SEMATUNE_SYSBENCH_HOST=127.0.0.1
export SEMATUNE_SYSBENCH_PORT=5432
export SEMATUNE_SYSBENCH_USER=admin
export SEMATUNE_SYSBENCH_PASSWORD=replace-with-local-password
export SEMATUNE_SYSBENCH_DB=benchdb
