{
  "benchmark_suite": "benchbase",
  "benchmark_type": "tpcc",
  "platform": "postgres",
  "config_file": "config/benchbase/postgres/sample_tpcc_config.xml",
  "results_dir": "results",
  "plot_dir": "plots/tpcc_bayesian_p99",
  "optimization_metric": "p_99_latency",
  "optimization_goal": "minimize",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "csv_output_file": "results/tpcc_bayesian_p99/optimization_results.csv",
  "tuner_type": "bayesian",
  "max_iterations": 200,
  "continuous_window": 8,
  "continuous_buffer": 1,
  "warm_up_windows": 0,
  "use_external_perf": true,
  "perf_cores": "0-1",
  "save_plots": true,
  "csv_output": true,
  "fixed_parameters": {
    "wakeup_granularity_ns": 500000
  },
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      1000000,
      500000000
    ]
  },
  "changes": {
    "75": [
      [
        "terminals",
        "8"
      ]
    ],
    "150": [
      [
        "terminals",
        "16"
      ]
    ]
  }
}