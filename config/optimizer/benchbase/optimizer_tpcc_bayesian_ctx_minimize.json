{
  "benchmark_suite": "benchbase",
  "benchmark_type": "tpcc",
  "platform": "postgres",
  "config_file": "config/benchbase/postgres/sample_tpcc_config.xml",
  "results_dir": "results",
  "plot_dir": "plots/tpcc_bayesian_ctx_minimize",
  "optimization_metric": "perf_context_switches",
  "optimization_goal": "minimize",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "csv_output_file": "results/tpcc_bayesian_ctx_minimize/optimization_results.csv",
  "tuner_type": "bayesian",
  "max_iterations": 200,
  "continuous_window": 8,
  "continuous_buffer": 1,
  "warm_up_windows": 0,
  "use_external_perf": true,
  "perf_cores": "0-1",
  "save_plots": true,
  "csv_output": true,
  "fixed_parameters": {
    "latency_ns": 1000,
    "wakeup_granularity_ns": 500000
  },
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ]
  }
}