{
  "benchmark_suite": "benchbase",
  "benchmark_type": "tpcc",
  "platform": "postgres",
  "config_file": "config/benchbase/postgres/sample_tpcc_config.xml",
  "results_dir": "results",
  "plot_dir": "plots/tpcc_default",
  "optimization_metric": "latency_median",
  "optimization_goal": "minimize",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "csv_output_file": "results/tpcc_lo/optimization_results.csv",
  "tuner_type": "random",
  "max_iterations": 3000,
  "continuous_window": 8,
  "continuous_buffer": 1,
  "warm_up_windows": 0,
  "use_external_perf": true,
  "perf_cores": "0-1",
  "save_plots": true,
  "csv_output": true,
  "stability_threshold": 3,
  "log_scale": true,
  "fixed_parameters": {
    "latency_ns": 1000
  },
  "benchmark_generator_rates": [1050, 700, 200],
  "parameter_ranges": {
    "min_granularity_ns": [100000, 100000000]
  }
}