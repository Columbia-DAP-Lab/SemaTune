{
  "benchmark_suite": "benchbase",
  "benchmark_type": "tpcc",
  "platform": "postgres",
  "config_file": "config/benchbase/postgres/sample_tpcc_config.xml",
  "results_dir": "results",
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ]
  },
  "fixed_parameters": {
    "latency_ns": 1000
  },
  "optimization_metric": "p_99_latency",
  "optimization_goal": "minimize",
  "max_iterations": 200,
  "tuner_type": "qlearning",
  "warm_up_windows": 0,
  "restart_each_iteration": false,
  "individual_mode": false,
  "warmup_time": 10,
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "continuous_window": 8,
  "continuous_buffer": 1,
  "custom_reward_function": null,
  "use_external_perf": false,
  "perf_events": "cycles,instructions,cache-references,cache-misses,branches,branch-misses",
  "perf_cores": null,
  "save_plots": true,
  "plot_dir": "plots/tpcc_qlearning_p99_1",
  "csv_output": true,
  "csv_output_file": "results/dqn_tpcc_optimization.csv",
  "stream_output": false,
  "perf_model_path": null,
  "perf_model_target_metric": null,
  "qlearning_grid_points": 8,
  "qlearning_learning_rate": 0.1,
  "qlearning_epsilon_start": 1.0,
  "qlearning_epsilon_end": 0.1,
  "qlearning_epsilon_decay": 0.995,
  "qlearning_gamma": 0.99,
  "qlearning_save_qtable": true
}