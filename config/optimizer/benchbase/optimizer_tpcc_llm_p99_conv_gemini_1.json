{
  "benchmark_suite": "benchbase",
  "benchmark_type": "tpcc",
  "platform": "postgres",
  "config_file": "config/benchbase/postgres/sample_tpcc_config.xml",
  "results_dir": "results",
  "plot_dir": "plots/tpcc_llm_p99_conv_gemini_1",
  "optimization_metric": "p_99_latency",
  "optimization_goal": "minimize",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "csv_output_file": "results/tpcc_llm_p99/optimization_results.csv",
  "tuner_type": "llm",
  "max_iterations": 200,
  "continuous_window": 8,
