    "latency_ns": 1000,
    "wakeup_granularity_ns": 500000
  },
  "llm_api_key": null,
  "llm_model_name": "gemini-2.5-pro",
  "llm_metrics_mode": "perf_only",
  "llm_dialog_mode": "conversational",
  "llm_thinking_budget": 10000,
  "llm_stability_threshold": 1
}