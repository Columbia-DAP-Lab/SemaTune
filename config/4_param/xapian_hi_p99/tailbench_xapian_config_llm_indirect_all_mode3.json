{
  "benchmark": "tailbench",
  "tailbench_app": "xapian",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 2700,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 2500,
  "tailbench_minsleepns": 0,
  "tailbench_xapian_db_path": "deps/Tailbench/tailbench.inputs/xapian/wiki",
  "tuner_type": "llm",
  "llm_model_name": "gemini-2.5-flash-lite",
  "llm_api_key": null,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ],
    "wakeup_granularity_ns": [
      100000,
      100000000
    ],
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns",
    "wakeup_granularity_ns",
    "cstate_max"
