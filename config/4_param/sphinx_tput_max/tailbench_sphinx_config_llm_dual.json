{
  "benchmark": "tailbench",
  "tailbench_app": "sphinx",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 20,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 100,
  "tailbench_minsleepns": 0,
  "tuner_type": "llm",
  "llm_api_key": null,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ],
    "wakeup_granularity_ns": [
      100000,
      100000000
    ],
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns",
    "wakeup_granularity_ns",
    "cstate_max"
  ],
  "fixed_parameters": {},
  "optimization_metric": "throughput",
  "optimization_goal": "maximize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "in-window",
  "results_dir": "results/sphinx_tput_max/llm_gemini_2_5_flash_lite_llm_dual/",
  "continuous_apply": false,
  "llm_actor_model": "gemini-2.5-flash",
  "llm_speculator_model": "gemini-2.5-flash-lite"
}
