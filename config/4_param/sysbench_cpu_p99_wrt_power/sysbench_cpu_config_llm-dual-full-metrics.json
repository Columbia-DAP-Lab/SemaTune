{
  "benchmark": "sysbench_cpu",
  "pin_to_cores": "0-9",
  "sysbench_threads": 40,
  "sysbench_cpu_max_prime": 50000,
  "tuner_type": "llm",
  "constraint_metric": "power_socket0_watts",
  "constraint_threshold": 80.0,
  "constraint_direction": "less_than",
  "constraint_penalty": 1000000.0,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ],
    "wakeup_granularity_ns": [
      100000,
      100000000
    ],
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns",
    "wakeup_granularity_ns",
    "cstate_max"
  ],
  "optimization_metric": "latency_p99",
  "optimization_goal": "minimize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "continuous_apply": false,
  "results_dir": "results/sysbench_cpu_p99/llm_gemini_2_5_flash_lite_llm_dual_full_metrics/",
  "llm_api_key": null,
  "llm_actor_model": "gemini-2.5-flash",
  "llm_speculator_model": "gemini-2.5-flash-lite",
  "trimming_enabled": false,
  "use_indirect_optimization": false,
  "llm_indirect_history_show_all_metrics": true,
  "llm_full_metrics_prompt_mode": true,
  "llm_additional_metrics": [
    "instructions_per_cycle",
    "cycles",
    "instructions",
    "branch_misses",
    "branch_miss_rate_pct",
    "page_faults",
    "context_switches_per_sec",
    "cpu_migrations_per_sec",
    "branches_per_sec",
    "power_socket0_watts",
    "power_ram_watts",
    "cstate_poll_pct",
    "cstate_c1_pct",
    "cstate_c1e_pct",
    "cstate_c6_pct",
    "cpu_load_cores_pct",
    "cpu_load_socket0_pct",
    "latency_p99"
  ]
}
