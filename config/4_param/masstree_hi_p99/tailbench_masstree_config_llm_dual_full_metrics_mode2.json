{
  "benchmark": "tailbench",
  "tailbench_app": "masstree",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 2000,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 2000,
  "tailbench_minsleepns": 0,
  "tuner_type": "llm",
  "llm_api_key": null,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ],
    "wakeup_granularity_ns": [
      100000,
      100000000
    ],
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns",
    "wakeup_granularity_ns",
    "cstate_max"
  ],
  "fixed_parameters": {},
  "optimization_metric": "latency_p99",
  "optimization_goal": "minimize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "in-window",
  "results_dir": "results/masstree_hi_p99/llm_gemini_2_5_flash_lite_llm_dual_full_metrics_mode2/",
  "continuous_apply": false,
  "llm_actor_model": "gemini-2.5-flash",
  "llm_speculator_model": "gemini-2.5-flash-lite",
  "use_indirect_optimization": false,
  "llm_full_metrics_prompt_mode": true,
  "llm_full_metrics_explicit_signature_compare": false,
  "llm_additional_metrics": [
    "instructions_per_cycle",
    "cycles",
    "instructions",
    "branch_misses",
    "branch_miss_rate_pct",
    "page_faults",
    "context_switches_per_sec",
    "cpu_migrations_per_sec",
    "branches_per_sec",
    "power_socket0_watts",
    "power_ram_watts",
    "cstate_poll_pct",
    "cstate_c1_pct",
    "cstate_c1e_pct",
    "cstate_c6_pct",
    "cpu_load_cores_pct",
    "cpu_load_socket0_pct",
    "latency_p99"
  ],
  "post_tuning_windows": 20
}
