{
  "benchmark": "twitter",
  "pin_to_cores": "0-9",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "benchbase_config_file": "config/benchbase/postgres/twitter_highload_config.xml",
  "tuner_type": "llm",
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ],
    "wakeup_granularity_ns": [
      100000,
      100000000
    ],
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns",
    "wakeup_granularity_ns",
    "cstate_max"
  ],
  "optimization_metric": "latency_p99",
  "optimization_goal": "minimize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "continuous_apply": false,
  "results_dir": "results/twitter_p99/llm_gemini_2_5_flash_lite_ipc/",
  "llm_model_name": "gemini-2.5-flash-lite",
  "llm_api_key": null,
  "llm_additional_metrics": [],
  "use_indirect_optimization": false
}
