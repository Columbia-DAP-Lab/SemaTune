{
  "benchmark": "sibench",
  "pin_to_cores": "0-9",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "benchbase_config_file": "config/benchbase/postgres/sample_sibench_hi.xml",
  "tuner_type": "llm",
  "llm_api_key": null,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ],
    "wakeup_granularity_ns": [
      100000,
      100000000
    ],
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns",
    "wakeup_granularity_ns",
    "cstate_max"
  ],
  "fixed_parameters": {},
  "optimization_metric": "latency_p99",
  "optimization_goal": "minimize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "in-window",
  "results_dir": "results/sibench_hi_p99/llm_gemini_2_5_flash_lite_llm_dual_ipc/",
  "continuous_apply": false,
  "llm_actor_model": "gemini-2.5-flash",
  "llm_speculator_model": "gemini-2.5-flash-lite",
  "use_indirect_optimization": false,
  "llm_additional_metrics": [],
  "llm_indirect_history_show_all_metrics": true
}
