{
  "benchmark": "tailbench",
  "tailbench_app": "sphinx",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 5,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 5,
  "tailbench_minsleepns": 0,
  "tuner_type": "llm",
  "llm_model_name": "gemini-2.5-flash",
  "llm_api_key": null,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ],
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ],
    "napi_busy_poll": [
      0,
      1000
    ],
    "wakeup_granularity_ns": [
      100000,
      100000000
    ],
    "migration_cost_ns": [
      100000,
      100000000
    ],
    "max_perf_pct": [
      0,
      100
    ],
    "min_perf_pct": [
      0,
      100
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns",
    "cstate_max",
    "napi_busy_poll",
    "wakeup_granularity_ns",
    "migration_cost_ns",
    "max_perf_pct",
    "min_perf_pct"
  ],
  "fixed_parameters": {},
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "throughput",
  "constraint_threshold": 3,
  "constraint_direction": "greater_than",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "results_dir": "results/sphinx_lo_pwr_wrt_p99/llm_gemini_2_5_flash_full_metrics/",
  "continuous_apply": false,
  "use_indirect_optimization": false,
  "llm_indirect_history_show_all_metrics": true,
  "llm_additional_metrics": [
    "instructions_per_cycle",
    "cycles",
    "instructions",
    "branch_misses",
    "branch_miss_rate_pct",
    "page_faults",
    "context_switches_per_sec",
    "cpu_migrations_per_sec",
    "branches_per_sec",
    "power_socket0_watts",
    "power_ram_watts",
    "cstate_poll_pct",
    "cstate_c1_pct",
    "cstate_c1e_pct",
    "cstate_c6_pct",
    "cpu_load_cores_pct",
    "cpu_load_socket0_pct",
    "throughput"
  ],
  "llm_full_metrics_prompt_mode": true
}
