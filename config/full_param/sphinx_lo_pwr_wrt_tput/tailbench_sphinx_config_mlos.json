{
    "benchmark": "tailbench",
    "tailbench_app": "sphinx",
    "pin_to_cores": "0-9",
    "tailbench_threads": 40,
    "tailbench_qps": 5,
    "tailbench_metrics_interval_sec": 1,
    "tailbench_maxreqs": 2000000000,
    "tailbench_warmupreqs": 5,
    "tailbench_minsleepns": 0,
    "tuner_type": "mlos",
    "parameter_ranges": {
        "min_granularity_ns": [
            100000,
            100000000
        ],
        "latency_ns": [
            100000,
            100000000
        ],
        "cstate_max": [
            "POLL",
            "C6",
            "C3",
            "C1E",
            "C1"
        ],
        "napi_busy_poll": [
            0,
            1000
        ],
        "wakeup_granularity_ns": [
            100000,
            100000000
        ],
        "migration_cost_ns": [
            100000,
            100000000
        ],
        "max_perf_pct": [
            0,
            100
        ],
        "min_perf_pct": [
            0,
            100
        ]
    },
    "parameters_to_tune": [
        "min_granularity_ns",
        "latency_ns",
        "cstate_max",
        "napi_busy_poll",
        "wakeup_granularity_ns",
        "migration_cost_ns",
        "max_perf_pct",
        "min_perf_pct"
    ],
    "fixed_parameters": {},
    "optimization_metric": "power_socket0_watts",
    "optimization_goal": "minimize",
    "constraint_metric": "throughput",
    "constraint_threshold": 3,
    "constraint_direction": "greater_than",
    "max_iterations": 60,
    "window_duration": 10,
    "tuning_mode": "outside-of-window",
    "mlos_buffer_time": 1.0,
    "mlos_n_random_init": 5,
    "mlos_n_random_probability": 0.0,
    "mlos_max_ratio": 0.01,
    "results_dir": "results/sphinx_lo_pwr_wrt_p99/mlos/",
    "continuous_apply": false
}
