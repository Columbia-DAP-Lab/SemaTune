{
    "benchmark": "tailbench",
    "tailbench_app": "xapian",
    "pin_to_cores": "0-9",
    "tailbench_threads": 40,
    "tailbench_qps": 2700,
    "tailbench_metrics_interval_sec": 1,
    "tailbench_maxreqs": 2000000000,
    "tailbench_warmupreqs": 2500,
    "tailbench_minsleepns": 0,
    "tailbench_xapian_db_path": "deps/Tailbench/tailbench.inputs/xapian/wiki",
    "tuner_type": "mlos",
    "parameter_ranges": {
        "min_granularity_ns": [
            100000,
            100000000
        ],
        "latency_ns": [
            100000,
            100000000
        ],
        "cstate_max": [
            "POLL",
            "C6",
            "C3",
            "C1E",
            "C1"
        ],
        "napi_busy_poll": [
            0,
            1000
        ],
        "wakeup_granularity_ns": [
            100000,
            100000000
        ],
        "migration_cost_ns": [
            100000,
            100000000
        ],
        "max_perf_pct": [
            0,
            100
        ],
        "min_perf_pct": [
            0,
            100
        ]
    },
    "parameters_to_tune": [
        "min_granularity_ns",
        "latency_ns",
        "cstate_max",
        "napi_busy_poll",
        "wakeup_granularity_ns",
        "migration_cost_ns",
        "max_perf_pct",
        "min_perf_pct"
    ],
    "parameter_types": {
        "latency_ns": "integer"
    },
    "fixed_parameters": {},
    "optimization_metric": "latency_p99",
    "optimization_goal": "minimize",
    "max_iterations": 60,
    "window_duration": 10,
    "tuning_mode": "outside-of-window",
    "results_dir": "results/xapian_hi_p99/mlos/",
    "continuous_apply": false
}
