{
  "benchmark": "tpcc",
  "pin_to_cores": "0-9",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "benchbase_config_file": "config/benchbase/postgres/sample_tpcc_lo.xml",
  "tuner_type": "llm",
  "llm_api_key": null,
  "parameter_ranges": {
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ],
    "max_perf_pct": [
      0,
      100
    ]
  },
  "parameters_to_tune": [
    "cstate_max",
    "max_perf_pct"
  ],
  "fixed_parameters": {},
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p99",
  "constraint_threshold": 50,
  "constraint_direction": "less_than",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "in-window",
  "results_dir": "results/tpcc_lo_pwr_wrt_p99/llm_gemini_2_5_flash_lite_llm_dual_app_metrics_mode3/",
  "continuous_apply": false,
  "llm_actor_model": "gemini-2.5-flash",
  "llm_speculator_model": "gemini-2.5-flash-lite",
  "use_indirect_optimization": false,
  "llm_full_metrics_prompt_mode": true,
  "llm_full_metrics_explicit_signature_compare": true,
  "llm_additional_metrics": [
    "throughput",
    "goodput",
    "latency_avg",
    "latency_p95",
    "latency_p99",
    "queries_per_hour",
    "power_socket0_watts"
  ],
  "post_tuning_windows": 20
}
