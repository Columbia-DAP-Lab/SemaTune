{
  "benchmark": "ycsb",
  "pin_to_cores": "0-9",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "benchbase_config_file": "config/benchbase/postgres/sample_ycsb_lo.xml",
  "tuner_type": "llm",
  "llm_model_name": "gemini-2.5-flash",
  "llm_api_key": null,
  "parameter_ranges": {
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ],
    "max_perf_pct": [
      0,
      100
    ]
  },
  "parameters_to_tune": [
    "cstate_max",
    "max_perf_pct"
  ],
  "fixed_parameters": {},
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p99",
  "constraint_threshold": 7.0,
  "constraint_direction": "less_than",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "results_dir": "results/ycsb_lo_pwr_wrt_p99/llm_gemini_2_5_flash/",
  "continuous_apply": false
}
