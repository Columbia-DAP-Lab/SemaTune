{
  "benchmark": "ycsb",
  "pin_to_cores": "0-9",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "benchbase_config_file": "config/benchbase/postgres/sample_ycsb_hi.xml",
  "tuner_type": "qlearning",
  "optimization_metric": "latency_p99",
  "optimization_goal": "minimize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "results_dir": "results/ycsb_hi_p99/qlearning/",
  "continuous_apply": false,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns"
  ],
  "parameter_types": {
    "min_granularity_ns": "integer",
    "latency_ns": "integer"
  }
}
