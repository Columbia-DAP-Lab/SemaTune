{
  "benchmark": "sysbench_oltp",
  "pin_to_cores": "0-9",
  "sysbench_threads": 40,
  "tuner_type": "mlos",
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ]
