{
  "benchmark": "tailbench",
  "tailbench_app": "silo",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 2700,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 2700,
  "tailbench_minsleepns": 0,
  "tuner_type": "bayesian",
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns"
  ],
  "fixed_parameters": {},
  "optimization_metric": "latency_p99",
  "optimization_goal": "minimize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "results_dir": "results/silo_hi_p99/bayesian/"
}
