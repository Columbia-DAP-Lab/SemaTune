{
  "benchmark": "tailbench",
  "tailbench_app": "sphinx",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 5,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 5,
  "tailbench_minsleepns": 0,
  "tuner_type": "mlos",
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p99",
  "constraint_threshold": 1000.0,
  "constraint_direction": "less_than",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "mlos_buffer_time": 1.0,
  "mlos_n_random_init": 5,
  "mlos_n_random_probability": 0.0,
  "mlos_max_ratio": 0.01,
  "results_dir": "results/sphinx_lo_pwr_wrt_p99/mlos/",
  "continuous_apply": false,
  "parameter_ranges": {
    "cstate_max": [
      "POLL",
      "C6",
      "C1E",
      "C1"
    ],
    "max_perf_pct": [
      20,
      100
    ]
  },
  "parameters_to_tune": [
    "cstate_max",
    "max_perf_pct"
  ],
  "parameter_types": {
    "max_perf_pct": "integer",
    "cstate_max": "categorical"
  },
  "fixed_parameters": {}
}
