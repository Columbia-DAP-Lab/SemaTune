{
  "benchmark": "tailbench",
  "tailbench_app": "silo",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 100,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 100,
  "tailbench_minsleepns": 0,
  "tuner_type": "llm",
  "llm_model_name": "gemini-2.5-flash-lite",
  "llm_api_key": null,
  "parameter_ranges": {
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ],
    "max_perf_pct": [
      0,
      100
    ]
  },
  "parameters_to_tune": [
    "cstate_max",
    "max_perf_pct"
  ],
  "fixed_parameters": {},
  "optimization_metric": "instructions_per_cycle",
  "optimization_goal": "maximize",
  "constraint_metric": "latency_p99",
  "constraint_threshold": 0.6,
  "constraint_direction": "less_than",
  "use_indirect_optimization": false,
  "llm_additional_metrics": [],
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "results_dir": "results/silo_lo_pwr_wrt_p99/llm_gemini_2_5_flash_lite_ipc/",
  "continuous_apply": false
}
