{
  "benchmark": "sysbench_oltp",
  "pin_to_cores": "0-9",
  "sysbench_threads": 40,
  "tuner_type": "mlos",
  "parameter_ranges": {
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ],
    "max_perf_pct": [
      0,
      100
    ]
  },
  "parameters_to_tune": [
    "cstate_max",
    "max_perf_pct"
  ],
  "fixed_parameters": {},
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p99",
  "constraint_threshold": 10.0,
  "constraint_direction": "less_than",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "results_dir": "results/sysbench_oltp_rw_lo_pwr_wrt_p99/mlos/",
  "continuous_apply": false
}
