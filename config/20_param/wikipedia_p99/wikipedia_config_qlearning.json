    "sched_cfs_bandwidth_slice_us": [
      1000,
      50000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns",
    "cstate_max",
    "napi_busy_poll",
    "wakeup_granularity_ns",
    "migration_cost_ns",
