      100000,
      100000000
    ],
    "migration_cost_ns": [
      100000,
      100000000
    ],
    "max_perf_pct": [
      0,
      100
    ],
    "min_perf_pct": [
      0,
      100
    ],
    "epp": [
      "default",
      "performance",
      "balance_performance",
      "balance_power",
      "power"
    ],
    "turbo": [
