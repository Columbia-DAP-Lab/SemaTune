    ],
    "netdev_budget_usecs": [
      0,
      20000
    ],
    "vm_swappiness": [
      0,
      100
    ],
    "vm_dirty_ratio": [
      1,
      80
    ],
    "vm_dirty_background_ratio": [
      1,
      40
    ],
    "zone_reclaim_mode": [
      0,
      7
    ],
    "sched_autogroup_enabled": [
      true,
      false
    ],
    "sched_cfs_bandwidth_slice_us": [
      1000,
      50000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns",
    "cstate_max",
    "napi_busy_poll",
    "wakeup_granularity_ns",
    "migration_cost_ns",
    "max_perf_pct",
    "min_perf_pct",
    "epp",
    "turbo",
    "pmqos",
    "busy_read",
    "netdev_budget",
    "netdev_budget_usecs",
    "vm_swappiness",
