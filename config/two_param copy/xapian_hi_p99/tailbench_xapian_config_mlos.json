{
  "benchmark": "tailbench",
  "tailbench_app": "xapian",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 2700,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 2500,
  "tailbench_minsleepns": 0,
  "tailbench_xapian_db_path": "deps/Tailbench/tailbench.inputs/xapian/wiki",
  "tuner_type": "mlos",
  "parameter_ranges": {
    "latency_ns": [
      1000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "latency_ns"
  ],
  "parameter_types": {
    "latency_ns": "integer"
  },
  "fixed_parameters": {
    "latency_ns": 1000
  },
  "optimization_metric": "latency_p99",
  "optimization_goal": "minimize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "results_dir": "results/xapian_hi_p99/mlos/",
  "continuous_apply": true
}