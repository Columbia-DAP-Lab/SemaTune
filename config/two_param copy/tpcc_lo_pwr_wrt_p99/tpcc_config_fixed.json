{
    "benchmark": "tpcc",
    "pin_to_cores": "0-9",
    "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
    "benchbase_config_file": "deps/benchbase/config/postgres/sample_tpcc_lo.xml",
    "tuner_type": "fixed",
    "parameter_ranges": {
        "max_perf_pct": [
            20,
            100
        ],
        "cstate_max": [
            "POLL",
            "C6",
            "C1E",
            "C1"
        ]
    },
    "parameters_to_tune": [
        "max_perf_pct",
        "cstate_max"
    ],
    "optimization_metric": "power_socket0_watts",
    "optimization_goal": "minimize",
    "constraint_metric": "latency_p99",
    "constraint_threshold": 50.0,
    "constraint_direction": "less_than",
    "constraint_penalty": 100000.0,
    "max_iterations": 60,
    "window_duration": 7,
    "tuning_mode": "outside-of-window",
    "results_dir": "results/tpcc_lo_pwr_wrt_p99/fixed/",
    "continuous_apply": false
}