{
  "benchmark": "sysbench_cpu",
  "pin_to_cores": "0-9",
  "sysbench_threads": 40,
  "sysbench_cpu_max_prime": 50000,
  "tuner_type": "mlos",
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns"
  ],
  "parameter_types": {
    "min_granularity_ns": "integer",
    "latency_ns": "integer"
  },
  "optimization_metric": "latency_p99",
  "optimization_goal": "minimize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "continuous_apply": false,
  "results_dir": "results/sysbench_cpu_p99/mlos/"
}