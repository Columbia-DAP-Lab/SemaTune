{
    "benchmark": "tailbench",
    "tailbench_app": "sphinx",
    "pin_to_cores": "0-9",
    "tailbench_threads": 40,
    "tailbench_qps": 20,
    "tailbench_metrics_interval_sec": 1,
    "tailbench_maxreqs": 2000000000,
    "tailbench_warmupreqs": 100,
    "tailbench_minsleepns": 0,
    "tuner_type": "llm",
    "llm_model_name": "gemini-2.5-flash-lite",
    "llm_api_key": null,
    "parameter_ranges": {
        "min_granularity_ns": [
            100000,
            100000000
        ],
        "latency_ns": [
            100000,
            100000000
        ]
    },
    "parameters_to_tune": [
        "min_granularity_ns",
        "latency_ns"
    ],
    "optimization_metric": "throughput",
    "optimization_goal": "maximize",
    "max_iterations": 60,
    "window_duration": 7,
    "tuning_mode": "outside-of-window",
    "results_dir": "results/sphinx_tput_max/llm/",
    "continuous_apply": false
}