{
  "benchmark": "sysbench_cpu",
  "pin_to_cores": "0-9",
  "sysbench_threads": 40,
  "sysbench_cpu_max_prime": 50000,
  "tuner_type": "bayesian",
  "constraint_metric": "power_socket0_watts",
  "constraint_threshold": 80.0,
  "constraint_direction": "less_than",
  "constraint_penalty": 1000000.0,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ],
    "latency_ns": [
      100000,
      100000000
    ],
    "cstate_max": [
      "POLL",
      "C6",
      "C3",
      "C1E",
      "C1"
    ],
    "napi_busy_poll": [
      0,
      1000
    ],
    "wakeup_granularity_ns": [
      100000,
      100000000
    ],
    "migration_cost_ns": [
      100000,
      100000000
    ],
    "max_perf_pct": [
      0,
      100
    ],
    "min_perf_pct": [
      0,
      100
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns",
    "latency_ns",
    "cstate_max",
    "napi_busy_poll",
    "wakeup_granularity_ns",
    "migration_cost_ns",
    "max_perf_pct",
    "min_perf_pct"
  ],
  "optimization_metric": "latency_p99",
  "optimization_goal": "minimize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "continuous_apply": false,
  "results_dir": "results/sysbench_cpu_p99/bayesian/"
}
