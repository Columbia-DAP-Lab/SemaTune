{
  "benchmark": "ycsb",
  "pin_to_cores": "0-9",
  "sysbench_threads": 40,
  "tuner_type": "llm",
  "llm_secondary_model": "gemini-2.5-flash-lite",
  "llm_api_key": null,
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "benchbase_config_file": "config/benchbase/postgres/sample_ycsb_lo.xml",
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns"
  ],
  "fixed_parameters": {
    "cstate_max": "POLL"
  },
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p99",
  "constraint_threshold": 10,
  "constraint_direction": "less_than",
  "max_iterations": 20,
  "window_duration": 2,
  "tuning_mode": "in-window",
  "results_dir": "results/sysbench_oltp_rw_lo_pwr_wrt_p99/llm_gemini_2_5_flash_lite_llm_dual_ipc/",
  "continuous_apply": true,
  "llm_actor_model": "gemini-2.5-flash",
  "llm_speculator_model": "gemini-2.5-flash-lite",
  "use_indirect_optimization": false,
  "llm_additional_metrics": [],
  "llm_indirect_history_show_all_metrics": true
}
