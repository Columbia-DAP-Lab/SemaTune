{
  "benchmark": "tailbench",
  "tailbench_app": "sphinx",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 5,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 5,
  "tailbench_minsleepns": 0,
  "tuner_type": "mlos",
  "llm_model_name": "gemini-2.5-flash-lite",
  "llm_api_key": null,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns"
  ],
  "fixed_parameters": {
    "cstate_max": "POLL"
  },
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p99",
  "constraint_threshold": 1000.0,
  "constraint_direction": "less_than",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "results_dir": "results/sphinx_lo_pwr_wrt_p99/llm_gemini_2_5_flash_lite_mlos_trimming/",
  "continuous_apply": false,
  "trimming_enabled": true,
  "trimming_cycles": 5,
  "trimming_model_name": "gemini-2.5-flash-lite"
}
