{
  "benchmark": "tpcc",
  "pin_to_cores": "0-9",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "benchbase_config_file": "config/benchbase/postgres/sample_tpcc_lo.xml",
  "tuner_type": "llm",
  "llm_model_name": "gemini-2.5-flash",
  "llm_api_key": null,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns"
  ],
  "fixed_parameters": {
    "cstate_max": "POLL"
  },
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p99",
  "constraint_threshold": 50.0,
  "constraint_direction": "less_than",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "results_dir": "results/tpcc_lo_pwr_wrt_p99/llm_gemini_2_5_flash_ipc/",
  "continuous_apply": false,
  "use_indirect_optimization": false,
  "llm_additional_metrics": [],
  "llm_indirect_history_show_all_metrics": true
}
