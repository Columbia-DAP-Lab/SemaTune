{
  "benchmark": "dcperf_django",
  "django_backend_cores": "0-9",
  "django_client_cores": "10-19",
  "dcperf_benchmark_name": "django_workload_quick",
  "dcperf_max_runtime": 1200,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns"
  ],
  "optimization_metric": "transaction_rate",
  "optimization_goal": "maximize",
  "max_iterations": 20,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "continuous_apply": false,
  "tuner_type": "dqn",
  "results_dir": "results/dcperf_django_hi_tput/dqn/",
  "fixed_parameters": {
    "latency_ns": 1000
  }
}
