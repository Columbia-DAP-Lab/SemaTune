{
  "benchmark": "tailbench",
  "tailbench_app": "xapian",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 100,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 100,
  "tailbench_minsleepns": 0,
  "tailbench_xapian_db_path": "/tmp/benchmark_db",
  "tuner_type": "llm",
  "llm_api_key": null,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns"
  ],
  "fixed_parameters": {
    "cstate_max": "POLL"
  },
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p99",
  "constraint_threshold": 20,
  "constraint_direction": "less_than",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "in-window",
  "results_dir": "results/xapian_lo_pwr_wrt_p99/llm_gemini_2_5_flash_lite_llm_dual_app_metrics_mode2/",
  "continuous_apply": false,
  "llm_actor_model": "gemini-2.5-flash",
  "llm_speculator_model": "gemini-2.5-flash-lite",
  "use_indirect_optimization": false,
  "llm_full_metrics_prompt_mode": true,
  "llm_full_metrics_explicit_signature_compare": false,
  "llm_additional_metrics": [
    "throughput",
    "goodput",
    "latency_avg",
    "latency_p95",
    "latency_p99",
    "queries_per_hour",
    "power_socket0_watts"
  ],
  "post_tuning_windows": 20
}
