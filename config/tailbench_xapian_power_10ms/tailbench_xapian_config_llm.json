{
  "benchmark": "tailbench",
  "tailbench_app": "xapian",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 10000,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 10000,
  "tailbench_minsleepns": 0,
  "tailbench_xapian_db_path": "deps/Tailbench/tailbench.inputs/xapian/wiki",
  "tuner_type": "llm",
  "llm_model_name": "gemini-2.5-flash-lite",
  "llm_api_key": null,
  "parameter_ranges": {
    "max_perf_pct": [
      20,
      100
    ]
  },
  "parameters_to_tune": [
    "max_perf_pct"
  ],
  "fixed_parameters": {
    "cstate_max": "unlimited"
  },
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p95",
  "constraint_threshold": 20.0,
  "constraint_direction": "less_than",
  "constraint_penalty": 1000.0,
  "max_iterations": 100,
  "window_duration": 10,
  "tuning_mode": "in-window",
  "results_dir": "results/tailbench_xapian_power_10ms_llm"
}