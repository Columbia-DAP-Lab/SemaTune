{
    "benchmark": "tailbench",
    "tailbench_app": "sphinx",
    "pin_to_cores": "0-9",
    "tailbench_threads": 40,
    "tailbench_metrics_interval_sec": 5,
    "tailbench_qps": 20,
    "tailbench_maxreqs": 2000000000,
    "tailbench_warmupreqs": 100,
    "tailbench_minsleepns": 0,
    "tailbench_output_dir": "~/os-param-tuning/sphinx_results",
    "tuner_type": "mlos",
    "parameter_ranges": {
        "max_perf_pct": [
            20,
            100
        ]
    },
    "parameter_types": {
        "max_perf_pct": "int"
    },
    "parameters_to_tune": [
        "max_perf_pct"
    ],
    "fixed_parameters": {
        "cstate_max": "POLL"
    },
    "mlos_buffer_time": 0,
    "mlos_n_random_init": 5,
    "mlos_n_random_probability": 0.15,
    "mlos_max_ratio": 1,
    "continuous_apply": true,
    "optimization_metric": "throughput_rps",
    "optimization_goal": "maximize",
    "constraint_metric": "latency_p95",
    "constraint_threshold": 5000.0,
    "constraint_direction": "less_than",
    "max_iterations": 100,
    "window_duration": 30,
    "tuning_mode": "in-window"
}