{
    "benchmark": "tailbench",
    "tailbench_app": "sphinx",
    "pin_to_cores": "0-9",
    "tailbench_threads": 40,
    "tailbench_metrics_interval_sec": 5,
    "tailbench_qps": 5,
    "tailbench_maxreqs": 2000000000,
    "tailbench_warmupreqs": 100,
    "tailbench_minsleepns": 0,
    "tailbench_output_dir": "~/os-param-tuning/sphinx_results",
    "tuner_type": "llm",
    "parameter_ranges": {
        "max_perf_pct": [
            20,
            100
        ]
    },
    "parameters_to_tune": [
        "max_perf_pct"
    ],
    "fixed_parameters": {
        "cstate_max": "POLL"
    },
    "llm_model_name": "gemini/gemini-2.0-flash-lite",
    "llm_api_key": null,
    "optimization_metric": "latency_p99",
    "optimization_goal": "minimize",
    "max_iterations": 100,
    "window_duration": 30,
    "tuning_mode": "in-window"
}
