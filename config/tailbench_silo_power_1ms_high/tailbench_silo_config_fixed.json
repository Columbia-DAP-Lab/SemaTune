{
    "benchmark": "tailbench",
    "tailbench_app": "silo",
    "pin_to_cores": "0-9",
    "tailbench_threads": 40,
    "tailbench_metrics_interval_sec": 1,
    "tailbench_qps": 2000,
    "tailbench_maxreqs": 2000000000,
    "tailbench_warmupreqs": 1000,
    "tailbench_minsleepns": 0,
    "tailbench_output_dir": "~/os-param-tuning/silo_results",
    "tuner_type": "fixed",
    "parameter_ranges": {
        "max_perf_pct": [
            20,
            100
        ]
    },
    "parameters_to_tune": [
        "max_perf_pct"
    ],
    "fixed_parameters": {
        "cstate_max": "POLL"
    },
    "optimization_metric": "power_socket0_watts",
    "optimization_goal": "minimize",
    "constraint_metric": "latency_p95",
    "constraint_threshold": 1.0,
    "constraint_direction": "less_than",
    "max_iterations": 100,
    "window_duration": 10,
    "tuning_mode": "in-window"
}