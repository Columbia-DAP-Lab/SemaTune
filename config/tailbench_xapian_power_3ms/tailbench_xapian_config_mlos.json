{
  "benchmark": "tailbench",
  "tailbench_app": "xapian",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 2700,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 10000,
  "tailbench_minsleepns": 0,
  "tailbench_xapian_db_path": "deps/Tailbench/tailbench.inputs/xapian/wiki",
  "tuner_type": "mlos",
  "parameter_ranges": {
    "max_perf_pct": [
      20,
      100
    ],
    "cstate_max": [
      "unlimited",
      "C6",
      "C1",
      "POLL"
    ]
  },
  "parameters_to_tune": [
    "max_perf_pct",
    "cstate_max"
  ],
  "parameter_types": {
    "max_perf_pct": "integer",
    "cstate_max": "categorical"
  },
  "fixed_parameters": {},
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p95",
  "constraint_threshold": 3.0,
  "constraint_direction": "less_than",
  "constraint_penalty": 10000.0,
  "max_iterations": 100,
  "window_duration": 10,
  "tuning_mode": "in-window",
  "mlos_buffer_time": 1.0,
  "mlos_n_random_init": 5,
  "mlos_n_random_probability": 0.0,
  "mlos_max_ratio": 0.01,
  "results_dir": "results/tailbench_xapian_power_3ms_mlos",
  "continuous_apply": true
}