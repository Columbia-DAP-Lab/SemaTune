{
    "benchmark": "tailbench",
    "tailbench_app": "sphinx",
    "pin_to_cores": "0-9",
    "tailbench_threads": 40,
    "tailbench_qps": 20,
    "tailbench_metrics_interval_sec": 1,
    "tuner_type": "llm",
    "llm_model_name": "gemini-2.5-flash-lite",
    "llm_api_key": null,
    "parameter_ranges": {
        "min_granularity_ns": [
            100000,
            100000000
        ]
    },
    "parameters_to_tune": [
        "min_granularity_ns"
    ],
    "fixed_parameters": {},
    "optimization_metric": "latency_p99",
    "optimization_goal": "minimize",
    "max_iterations": 60,
    "window_duration": 10,
    "tuning_mode": "outside-of-window",
    "results_dir": "results/sphinx_hi_p99/llm_gemini_2_5_flash_lite_ipc/",
    "continuous_apply": false,
    "use_indirect_optimization": true,
    "llm_additional_metrics": [
        "ipc"
    ]
}