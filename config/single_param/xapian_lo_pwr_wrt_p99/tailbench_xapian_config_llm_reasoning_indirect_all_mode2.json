{
  "benchmark": "tailbench",
  "tailbench_app": "xapian",
  "pin_to_cores": "0-9",
  "tailbench_threads": 40,
  "tailbench_qps": 100,
  "tailbench_metrics_interval_sec": 1,
  "tailbench_maxreqs": 2000000000,
  "tailbench_warmupreqs": 100,
  "tailbench_minsleepns": 0,
  "tailbench_xapian_db_path": "deps/Tailbench/tailbench.inputs/xapian/wiki",
  "tuner_type": "llm",
  "llm_model_name": "gemini-2.5-flash",
  "llm_api_key": null,
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns"
  ],
  "fixed_parameters": {},
  "optimization_metric": "power_socket0_watts",
  "optimization_goal": "minimize",
  "constraint_metric": "latency_p99",
  "constraint_threshold": 20.0,
  "constraint_direction": "less_than",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "results_dir": "results/xapian_lo_pwr_wrt_p99/llm_gemini_2_5_flash_indirect_all_mode2/",
  "continuous_apply": false,
  "use_indirect_optimization": true,
  "llm_indirect_history_show_all_metrics": true,
  "llm_additional_metrics": [
    "instructions_per_cycle",
    "cycles",
    "instructions",
    "branch_misses",
    "branch_miss_rate_pct",
    "page_faults",
    "context_switches_per_sec",
    "cpu_migrations_per_sec",
    "branches_per_sec",
    "power_socket0_watts",
    "power_ram_watts",
    "cstate_poll_pct",
    "cstate_c1_pct",
    "cstate_c1e_pct",
    "cstate_c6_pct",
    "cpu_load_cores_pct",
    "cpu_load_socket0_pct"
  ],
  "omit_explicit_pairwise_comparison_instruction": 2,
  "llm_indirect_prompt_style": "signature_compare"
}
