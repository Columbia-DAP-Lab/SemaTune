{
  "benchmark": "twitter",
  "pin_to_cores": "0-9",
  "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
  "benchbase_config_file": "config/benchbase/postgres/twitter_highload_config.xml",
  "tuner_type": "bayesian",
  "parameter_ranges": {
    "min_granularity_ns": [
      100000,
      100000000
    ]
  },
  "parameters_to_tune": [
    "min_granularity_ns"
  ],
  "optimization_metric": "latency_p99",
  "optimization_goal": "minimize",
  "max_iterations": 60,
  "window_duration": 10,
  "tuning_mode": "outside-of-window",
  "continuous_apply": false,
  "results_dir": "results/twitter_p99/bayesian/"
}
