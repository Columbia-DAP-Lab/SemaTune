{
    "benchmark": "tailbench",
    "tailbench_app": "sphinx",
    "pin_to_cores": "0-9",
    "tailbench_threads": 40,
    "tailbench_qps": 5,
    "tailbench_metrics_interval_sec": 1,
    "tailbench_maxreqs": 2000000000,
    "tailbench_warmupreqs": 5,
    "tailbench_minsleepns": 0,
    "tuner_type": "fixed",
    "parameter_ranges": {
        "max_perf_pct": [
            20,
            100
        ]
    },
    "parameters_to_tune": [
        "max_perf_pct"
    ],
    "fixed_parameters": {
        "cstate_max": "POLL"
    },
    "optimization_metric": "power_socket0_watts",
    "optimization_goal": "minimize",
    "constraint_metric": "throughput",
    "constraint_threshold": 3,
    "constraint_direction": "greater_than",
    "max_iterations": 60,
    "window_duration": 10,
    "tuning_mode": "outside-of-window",
    "results_dir": "results/sphinx_lo_pwr_wrt_p99/fixed/"
}