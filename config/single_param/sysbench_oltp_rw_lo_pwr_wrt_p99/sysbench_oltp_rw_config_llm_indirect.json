{
    "benchmark": "ycsb",
    "pin_to_cores": "0-9",
    "sysbench_threads": 40,
    "tuner_type": "llm",
    "llm_model_name": "gemini-2.5-flash",
    "llm_secondary_model": "gemini-2.5-flash-lite",
    "llm_api_key": null,
    "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
    "benchbase_config_file": "config/benchbase/postgres/sample_ycsb_lo.xml",
    "parameter_ranges": {
        "max_perf_pct": [
            20,
            100
        ]
    },
    "parameters_to_tune": [
        "max_perf_pct"
    ],
    "fixed_parameters": {
        "cstate_max": "POLL"
    },
    "optimization_metric": "power_socket0_watts",
    "optimization_goal": "minimize",
    "constraint_metric": "latency_p99",
    "constraint_threshold": 10.0,
    "constraint_direction": "less_than",
    "max_iterations": 20,
    "window_duration": 2,
    "tuning_mode": "outside-of-window",
    "results_dir": "results/sysbench_oltp_rw_lo_pwr_wrt_p99/llm_gemini_2_5_flash_lite_indirect/",
    "continuous_apply": true,
    "use_indirect_optimization": true,
    "llm_indirect_history_show_all_metrics": false,
    "llm_additional_metrics": [
        "instructions_per_cycle",
        "cycles",
        "instructions",
        "branch_misses",
        "branch_miss_rate_pct",
        "page_faults",
        "context_switches_per_sec",
        "cpu_migrations_per_sec",
        "branches_per_sec",
        "power_socket0_watts",
        "power_ram_watts",
        "cstate_poll_pct",
        "cstate_c1_pct",
        "cstate_c1e_pct",
        "cstate_c6_pct",
        "cpu_load_cores_pct",
        "cpu_load_socket0_pct"
    ]
}