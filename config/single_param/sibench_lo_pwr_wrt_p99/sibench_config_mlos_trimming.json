{
    "benchmark": "sibench",
    "pin_to_cores": "0-9",
    "benchbase_jar_path": "deps/benchbase/target/benchbase-postgres/benchbase.jar",
    "benchbase_config_file": "config/benchbase/postgres/sample_sibench_lo.xml",
    "tuner_type": "mlos",
    "llm_model_name": "gemini-2.5-flash-lite",
    "llm_api_key": null,
    "parameter_ranges": {
        "max_perf_pct": [
            20,
            100
        ]
    },
    "parameters_to_tune": [
        "max_perf_pct"
    ],
    "fixed_parameters": {
        "cstate_max": "POLL"
    },
    "optimization_metric": "power_socket0_watts",
    "optimization_goal": "minimize",
    "constraint_metric": "latency_p99",
    "constraint_threshold": 3.0,
    "constraint_direction": "less_than",
    "max_iterations": 60,
    "window_duration": 10,
    "tuning_mode": "outside-of-window",
    "results_dir": "results/sibench_lo_pwr_wrt_p99/llm_gemini_2_5_flash_lite_mlos_trimming/",
    "continuous_apply": false,
    "trimming_enabled": true,
    "trimming_cycles": 5,
    "trimming_model_name": "gemini-2.5-flash-lite"
}