    <works>
        <work>
            <time>5</time>
            <rate>200</rate>
            <weights>45,43,4,4,4</weights>
        </work>
    </works>

    
    <transactiontypes>
        <transactiontype>
            <name>NewOrder</name>
            
            
        </transactiontype>
        <transactiontype>
            <name>Payment</name>
            
            
        </transactiontype>
        <transactiontype>
            <name>OrderStatus</name>
            
            
        </transactiontype>
        <transactiontype>
            <name>Delivery</name>
            
            
        </transactiontype>
        <transactiontype>
            <name>StockLevel</name>
            
            
        </transactiontype>
    </transactiontypes>
